{
  "name": "testmate-ai-desktop",
  "version": "1.0.0",
  "description": "TestMate AI — Automated Mobile Game QA",
  "main": "main.js",
  "scripts": {
    "start": "node start-electron.js",
    "_stage": "rm -rf agent && rsync -a --exclude=node_modules ../agent/ agent/",
    "_unstage": "rm -rf agent",
    "build": "npm run _stage && (electron-builder; ec=$?; npm run _unstage; exit $ec)",
    "build:mac": "npm run _stage && (electron-builder --mac; ec=$?; npm run _unstage; exit $ec)",
    "build:win": "npm run _stage && (electron-builder --win; ec=$?; npm run _unstage; exit $ec)"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "app-info-parser": "^1.1.6",
    "unzipper": "^0.12.3"
  },
  "build": {
    "appId": "com.funcell.testmate",
    "productName": "TestMate AI",
    "asar": true,
    "asarUnpack": [
      "agent/adb/**",
      "agent/utils/toolPaths.js"
    ],
    "files": [
      "**/*",
      "!agent/node_modules",
      "!node_modules/.cache",
      "!dist/**",
      "!build/icon.iconset/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "extraResources": [
        { "from": "../tools/mac/", "to": "tools/mac/", "filter": ["**/*"] }
      ]
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "extraResources": [
        { "from": "../tools/win/", "to": "tools/win/", "filter": ["**/*"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TestMate AI"
    },
    "dmg": {
      "title": "TestMate AI",
      "window": { "width": 540, "height": 380 }
    }
  }
}
